# Analysis effort hint for the code-analysis Skill: low | medium | high
ANALYSIS_EFFORT=medium
# Repository paths; select one with --repository-name / -RepositoryName.
# Relative paths are resolved against the selected .env file's directory.
HARNESS_REPOSITORIES='{"backend":"D:/src/backend","frontend":"D:/src/frontend"}'
# Optional default path when no repository name is specified.
HARNESS_REPO=
HARNESS_BASE_BRANCH=master
# Git credentials are optional when Git Credential Manager is already logged in.
GIT_USERNAME=oauth2
GIT_PERSONAL_ACCESS_TOKEN=
# TAPD/DingTalk credentials used only for requirement fetching.
TAPD_ACCESS_TOKEN=
TAPD_API_BASE_URL=https://api.tapd.cn
# Optional DingTalk document bridge or OpenAPI credentials.
DINGTALK_DOC_BRIDGE_URL=
DINGTALK_DOC_BRIDGE_TOKEN=
# Needed only when running the bundled optional MCP-to-HTTP adapter.
DINGTALK_MCP_URL=
DINGTALK_ACCESS_TOKEN=
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_OPERATOR_ID=

# Optional MySQL read-only evidence queries (install the database extra).
# Use a dedicated SELECT-only account; SQL validation is not a privilege boundary.
# DATABASE_URL takes priority if set (mysql://user:password@host:3306/schema).
DATABASE_URL=
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
